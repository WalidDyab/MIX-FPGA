{
  "$schema": "vscode://schemas/color-theme",
  "name": "NexysVHDL Classroom",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "focusBorder": "#4da3ff",
    "foreground": "#d4dcea",
    "descriptionForeground": "#93a1b8",
    "disabledForeground": "#5d6b82",
    "errorForeground": "#ff7b72",
    "icon.foreground": "#a9b8d0",
    "selection.background": "#2c5aa080",
    "widget.shadow": "#050a14aa",

    "editor.background": "#0f1b2d",
    "editor.foreground": "#d4dcea",
    "editorLineNumber.foreground": "#4a5b78",
    "editorLineNumber.activeForeground": "#a9b8d0",
    "editorCursor.foreground": "#f28c28",
    "editor.selectionBackground": "#2c5aa088",
    "editor.inactiveSelectionBackground": "#2c5aa044",
    "editor.selectionHighlightBackground": "#2c5aa044",
    "editor.wordHighlightBackground": "#2c5aa055",
    "editor.findMatchBackground": "#f28c2866",
    "editor.findMatchHighlightBackground": "#f28c2833",
    "editor.lineHighlightBackground": "#14233a",
    "editor.lineHighlightBorder": "#14233a",
    "editorIndentGuide.background1": "#1f3050",
    "editorIndentGuide.activeBackground1": "#3a5078",
    "editorWhitespace.foreground": "#2a3b5a",
    "editorBracketMatch.background": "#2c5aa066",
    "editorBracketMatch.border": "#4da3ff",
    "editorError.foreground": "#ff7b72",
    "editorWarning.foreground": "#f2b84b",
    "editorInfo.foreground": "#4da3ff",
    "editorGutter.addedBackground": "#3fb27f",
    "editorGutter.modifiedBackground": "#4da3ff",
    "editorGutter.deletedBackground": "#ff7b72",
    "editorWidget.background": "#16263f",
    "editorWidget.border": "#27406a",
    "editorSuggestWidget.selectedBackground": "#22406e",
    "editorHoverWidget.background": "#16263f",
    "editorHoverWidget.border": "#27406a",

    "activityBar.background": "#0a1424",
    "activityBar.foreground": "#f28c28",
    "activityBar.inactiveForeground": "#6b7c98",
    "activityBar.border": "#0a1424",
    "activityBarBadge.background": "#f28c28",
    "activityBarBadge.foreground": "#0a1424",
    "activityBar.activeBorder": "#f28c28",

    "sideBar.background": "#0c172a",
    "sideBar.foreground": "#c3cee0",
    "sideBar.border": "#1a2a45",
    "sideBarTitle.foreground": "#d4dcea",
    "sideBarSectionHeader.background": "#1b3a66",
    "sideBarSectionHeader.foreground": "#ffffff",
    "sideBarSectionHeader.border": "#f28c28",

    "list.activeSelectionBackground": "#22406e",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#192e50",
    "list.hoverBackground": "#14263f",
    "list.focusBackground": "#22406e",
    "list.highlightForeground": "#f28c28",
    "tree.indentGuidesStroke": "#2a3b5a",

    "titleBar.activeBackground": "#0a1424",
    "titleBar.activeForeground": "#c3cee0",
    "titleBar.inactiveBackground": "#0a1424",
    "titleBar.inactiveForeground": "#6b7c98",
    "titleBar.border": "#1a2a45",

    "tab.activeBackground": "#0f1b2d",
    "tab.activeForeground": "#ffffff",
    "tab.activeBorderTop": "#f28c28",
    "tab.inactiveBackground": "#0a1424",
    "tab.inactiveForeground": "#8393ad",
    "tab.border": "#0a1424",
    "tab.hoverBackground": "#14233a",
    "editorGroupHeader.tabsBackground": "#0a1424",
    "editorGroup.border": "#1a2a45",

    "panel.background": "#0c172a",
    "panel.border": "#1a2a45",
    "panelTitle.activeBorder": "#f28c28",
    "panelTitle.activeForeground": "#ffffff",
    "panelTitle.inactiveForeground": "#8393ad",

    "statusBar.background": "#143561",
    "statusBar.foreground": "#e6edf8",
    "statusBar.noFolderBackground": "#143561",
    "statusBar.debuggingBackground": "#f28c28",
    "statusBar.debuggingForeground": "#0a1424",
    "statusBar.border": "#143561",
    "statusBarItem.hoverBackground": "#1d4a85",
    "statusBarItem.remoteBackground": "#f28c28",
    "statusBarItem.remoteForeground": "#0a1424",

    "button.background": "#f28c28",
    "button.foreground": "#0a1424",
    "button.hoverBackground": "#f6a04d",
    "button.secondaryBackground": "#22406e",
    "button.secondaryForeground": "#e6edf8",
    "button.secondaryHoverBackground": "#2a4e86",
    "textLink.foreground": "#4da3ff",
    "textLink.activeForeground": "#7dbcff",
    "badge.background": "#f28c28",
    "badge.foreground": "#0a1424",
    "progressBar.background": "#f28c28",

    "input.background": "#0a1424",
    "input.border": "#27406a",
    "input.foreground": "#e6edf8",
    "input.placeholderForeground": "#6b7c98",
    "inputOption.activeBorder": "#f28c28",
    "dropdown.background": "#0a1424",
    "dropdown.border": "#27406a",
    "dropdown.foreground": "#e6edf8",

    "quickInput.background": "#16263f",
    "quickInputList.focusBackground": "#22406e",
    "pickerGroup.foreground": "#f28c28",
    "pickerGroup.border": "#27406a",

    "terminal.background": "#0a1424",
    "terminal.foreground": "#d4dcea",
    "terminalCursor.foreground": "#f28c28",
    "terminal.ansiBlue": "#4da3ff",
    "terminal.ansiBrightBlue": "#7dbcff",
    "terminal.ansiYellow": "#f2b84b",
    "terminal.ansiBrightYellow": "#f6c96f",
    "terminal.ansiGreen": "#3fb27f",
    "terminal.ansiBrightGreen": "#5fcf9b",
    "terminal.ansiRed": "#ff7b72",
    "terminal.ansiBrightRed": "#ff9a93",

    "testing.iconPassed": "#3fb27f",
    "testing.iconFailed": "#ff7b72",
    "problemsErrorIcon.foreground": "#ff7b72",
    "problemsWarningIcon.foreground": "#f2b84b",
    "problemsInfoIcon.foreground": "#4da3ff",

    "charts.blue": "#4da3ff",
    "charts.orange": "#f28c28",
    "charts.green": "#3fb27f",
    "charts.red": "#ff7b72",
    "charts.yellow": "#f2b84b",
    "charts.purple": "#b392f0",

    "scrollbarSlider.background": "#2a3b5a66",
    "scrollbarSlider.hoverBackground": "#3a507899",
    "scrollbarSlider.activeBackground": "#4a6498aa",
    "menu.background": "#16263f",
    "menu.selectionBackground": "#22406e",
    "notifications.background": "#16263f",
    "notificationCenterHeader.background": "#101e35",
    "peekViewEditor.background": "#101e35",
    "peekViewResult.background": "#0c172a",
    "peekViewTitle.background": "#101e35"
  },
  "tokenColors": [
    { "scope": ["comment", "comment.line", "comment.block"], "settings": { "foreground": "#8497b2", "fontStyle": "italic" } },
    { "scope": ["keyword", "keyword.control", "keyword.other", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#f28c28" } },
    { "scope": ["keyword.operator", "keyword.operator.word", "keyword.operator.arithmetic", "keyword.operator.comparison", "keyword.operator.assignment", "keyword.operator.other"], "settings": { "foreground": "#c3cee0" } },
    { "scope": ["storage.modifier.mode.vhdl"], "settings": { "foreground": "#f2b84b" } },
    { "scope": ["entity.name.type", "entity.name.type.entity", "entity.name.type.architecture", "entity.name.type.package", "entity.name.type.component", "entity.name.type.configuration", "support.type", "support.type.std.vhdl"], "settings": { "foreground": "#6cc4ff" } },
    { "scope": ["entity.name.function", "support.function", "support.function.attribute"], "settings": { "foreground": "#9ecbff" } },
    { "scope": ["entity.name.namespace", "entity.name.namespace.library.vhdl", "entity.name.namespace.vhdl"], "settings": { "foreground": "#b392f0" } },
    { "scope": ["entity.name.label", "entity.name.label.vhdl", "entity.name.label.instance.vhdl"], "settings": { "foreground": "#e0b36a" } },
    { "scope": ["constant.numeric", "constant.numeric.decimal.vhdl", "constant.numeric.based.vhdl", "constant.numeric.bit-string.vhdl"], "settings": { "foreground": "#7ee0b0" } },
    { "scope": ["constant.character", "constant.language", "constant.language.boolean.vhdl", "constant.language.severity.vhdl"], "settings": { "foreground": "#7ee0b0" } },
    { "scope": ["string", "string.quoted.double.vhdl"], "settings": { "foreground": "#a5d6a7" } },
    { "scope": ["keyword.other.unit.vhdl"], "settings": { "foreground": "#7ee0b0" } },
    { "scope": ["punctuation", "punctuation.separator.vhdl", "punctuation.terminator.statement.vhdl", "punctuation.section.parens.vhdl", "punctuation.accessor.vhdl", "punctuation.accessor.attribute.vhdl"], "settings": { "foreground": "#93a1b8" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#f28c28", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#6cc4ff" } }
  ]
}
