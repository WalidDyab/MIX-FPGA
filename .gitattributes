# Store and check out text as LF on every platform, so portable sources
# (VHDL, XDC, apio.ini) stay byte-identical on Windows and macOS.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary FPGA / waveform artifacts (normally ignored anyway)
*.bit binary
*.bin binary
*.ghw binary

# Third-party license texts are kept byte-identical to upstream (no whitespace normalization or checks).
toolchains/bundle/licenses/** -whitespace -text
# Compliance-only license texts: upstream wording kept (trailing spaces included), stored with LF line endings;
# toolchains/compliance/licenses/*/SOURCES.md records the SHA-256 of each stored file.
toolchains/compliance/licenses/** -whitespace
