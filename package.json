    "configuration": {
      "title": "MIX-FPGA",
      "properties": {
        "nexysvhdl.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run Check (VHDL analysis) automatically when a project VHDL file is saved. Build never runs automatically."
        },
        "nexysvhdl.detectBoardsOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Look for connected boards when a project is opened."
        },
        "nexysvhdl.promptForClassroomAppearance": {
          "type": "boolean",
          "default": true,
          "description": "Offer the optional NexysVHDL Classroom appearance (a navy and orange color theme) the first time a project folder is opened. It is only ever applied to that project folder, never to your global VS Code theme."
        },
        "nexysvhdl.console.detail": {
          "type": "string",
          "enum": [
            "normal",
            "detailed"
          ],
          "default": "normal",
          "enumDescriptions": [
            "The MIX-FPGA Console shows progress, results and errors.",
            "The MIX-FPGA Console also streams the raw output of the FPGA tools while an action runs."
          ],
          "description": "How much the MIX-FPGA Console shows. Normal is meant for students; Detailed adds every line the FPGA tools print."
        }
      }
    },
    "languages": [
      {
        "id": "vhdl",
        "aliases": [
          "VHDL",
          "vhdl"
        ],
        "extensions": [
          ".vhd",
          ".vhdl"
        ],
        "configuration": "./resources/vhdl/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vhdl",
        "scopeName": "source.vhdl",
        "path": "./resources/vhdl/vhdl.tmLanguage.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "nexysvhdl.gettingStarted",
        "title": "Get started with MIX-FPGA",
        "description": "From VHDL to a programmed Nexys A7-100T: set up, create a project, check, simulate, build and program.",
        "steps": [
          {
            "id": "setup",
            "title": "Verify your setup",
            "description": "Check that the MIX-FPGA FPGA toolchain is installed (and, on Windows, the Digilent USB/JTAG support needed only for programming).\n[Show Environment](command:nexysvhdl.showEnvironment)\n[Install FPGA Toolchain…](command:nexysvhdl.installToolchain)",
            "media": {
              "markdown": "resources/walkthrough/setup.md"
            },
            "completionEvents": [
              "onCommand:nexysvhdl.showEnvironment"
            ]
          },
          {
            "id": "project",
            "title": "Create or open a project",
