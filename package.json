{
  "name": "nexysvhdl",
  "displayName": "MIX-FPGA",
  "version": "0.6.0",
  "description": "Classroom Preview: one VS Code environment for VHDL-2008 FPGA design on several boards (Nexys A7-100T, DE10-Lite). Check, simulate, waveforms, design and RTL schematics, build and program. MIX-FPGA is an EMXplore project.",
  "publisher": "emxplore",
  "private": true,
  "license": "Apache-2.0",
  "preview": true,
  "type": "commonjs",
  "main": "dist/extension/extension.js",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:nexysvhdl.json",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexysvhdl",
          "title": "MIX-FPGA",
          "icon": "resources/nexysvhdl.svg"
        }
      ]
    },
    "views": {
      "nexysvhdl": [
        {
          "id": "nexysvhdl.project",
          "name": "Project",
          "icon": "$(folder-library)"
        },
        {
          "id": "nexysvhdl.design",
          "name": "Design",
          "when": "nexysvhdl.hasProject",
          "icon": "$(type-hierarchy)"
        },
        {
          "id": "nexysvhdl.workflow",
          "name": "Workflow",
          "when": "nexysvhdl.hasProject",
          "icon": "$(play-circle)"
        },
        {
          "id": "nexysvhdl.hardware",
          "name": "Hardware",
          "when": "nexysvhdl.hasProject",
          "icon": "$(chip)"
        },
        {
          "id": "nexysvhdl.results",
          "name": "Results",
          "when": "nexysvhdl.hasProject",
          "visibility": "collapsed",
          "icon": "$(checklist)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nexysvhdl.project",
        "contents": "This Nexys A7 project needs its FPGA toolchain before MIX-FPGA can check, simulate or build it. It is installed once for your user account and reused by MIX-FPGA updates.\n[Install FPGA Toolchain…](command:nexysvhdl.installToolchain)\nChoose the nexysvhdl-toolchain file from the MIX-FPGA classroom download.",
        "when": "nexysvhdl.toolchainState == not-installed"
      },
      {
        "view": "nexysvhdl.project",
        "contents": "No MIX-FPGA project is open.\n[New Project](command:nexysvhdl.createProject)\n[Open Project](command:nexysvhdl.openProject)\nOpen a project folder (it contains nexysvhdl.json) or a .nvproj project file.\n[Getting Started](command:nexysvhdl.gettingStarted)\n[Show Environment](command:nexysvhdl.showEnvironment)",
        "when": "!nexysvhdl.hasProject"
      },
      {
        "view": "explorer",
        "contents": "MIX-FPGA (Nexys A7-100T, DE10-Lite)\n[Create MIX-FPGA Project](command:nexysvhdl.createProject)\n[Open MIX-FPGA Project](command:nexysvhdl.openProject)\n[MIX-FPGA: Getting Started](command:nexysvhdl.gettingStarted)",
        "when": "workbenchState == empty"
      }
    ],
