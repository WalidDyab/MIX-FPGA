{
  "name": "nexysvhdl",
  "displayName": "NexysVHDL",
  "version": "0.5.0",
  "description": "Classroom Preview: VHDL-2008 design for the Digilent Nexys A7-100T in VS Code. Check, simulate, waveforms, design and RTL schematics, build and program, using the separately installed NexysVHDL FPGA toolchain.",
  "publisher": "emxplore",
  "private": true,
  "license": "Apache-2.0",
  "preview": true,
  "type": "commonjs",
  "main": "dist/extension/extension.js",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:nexysvhdl.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexysvhdl",
          "title": "NexysVHDL",
          "icon": "resources/nexysvhdl.svg"
        }
      ]
    },
    "views": {
      "nexysvhdl": [
        {
          "id": "nexysvhdl.project",
          "name": "Project"
        },
        {
          "id": "nexysvhdl.files",
          "name": "Project Files",
          "when": "nexysvhdl.hasProject"
        },
        {
          "id": "nexysvhdl.hierarchy",
          "name": "Design Hierarchy",
          "when": "nexysvhdl.hasProject"
        },
        {
          "id": "nexysvhdl.workflow",
          "name": "Workflow",
          "when": "nexysvhdl.hasProject"
        },
        {
          "id": "nexysvhdl.hardware",
          "name": "Hardware",
          "when": "nexysvhdl.hasProject"
        },
        {
          "id": "nexysvhdl.results",
          "name": "Results",
          "when": "nexysvhdl.hasProject",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nexysvhdl.project",
        "contents": "NexysVHDL needs its FPGA toolchain before it can check, simulate or build designs. It is installed once for your user account and reused by NexysVHDL updates.\n[Install FPGA Toolchain…](command:nexysvhdl.installToolchain)\nChoose the nexysvhdl-toolchain file from the NexysVHDL classroom download.",
        "when": "nexysvhdl.toolchainState == not-installed"
      },
      {
        "view": "nexysvhdl.project",
        "contents": "No NexysVHDL project is open.\n[Create NexysVHDL Project](command:nexysvhdl.createProject)\n[Open NexysVHDL Project](command:nexysvhdl.openProject)\nA project is a folder containing nexysvhdl.json.\n[Getting Started](command:nexysvhdl.gettingStarted)\n[Show Environment](command:nexysvhdl.showEnvironment)",
        "when": "!nexysvhdl.hasProject"
      },
      {
        "view": "explorer",
        "contents": "NexysVHDL (Nexys A7 FPGA)\n[Create NexysVHDL Project](command:nexysvhdl.createProject)\n[Open NexysVHDL Project](command:nexysvhdl.openProject)\n[NexysVHDL: Getting Started](command:nexysvhdl.gettingStarted)",
        "when": "workbenchState == empty"
      }
    ],
    "commands": [
      {
        "command": "nexysvhdl.createProject",
        "title": "Create Project",
        "category": "NexysVHDL",
        "icon": "$(new-folder)"
      },
      {
        "command": "nexysvhdl.openProject",
        "title": "Open Project",
        "category": "NexysVHDL",
        "icon": "$(folder-opened)"
      },
      {
        "command": "nexysvhdl.refreshProject",
        "title": "Refresh Project",
        "category": "NexysVHDL",
        "icon": "$(refresh)"
      },
      {
        "command": "nexysvhdl.refreshHierarchy",
        "title": "Refresh Hierarchy",
        "category": "NexysVHDL",
        "icon": "$(refresh)"
      },
      {
        "command": "nexysvhdl.openProjectSettings",
        "title": "Open Project Settings",
        "category": "NexysVHDL",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nexysvhdl.setTopEntity",
        "title": "Set Top Entity",
        "category": "NexysVHDL"
      },
      {
        "command": "nexysvhdl.setTopEntityFromItem",
        "title": "Set as Top Entity",
        "category": "NexysVHDL"
      },
      {
        "command": "nexysvhdl.setTestbench",
        "title": "Set Testbench",
        "category": "NexysVHDL"
      },
      {
        "command": "nexysvhdl.useConstraintsFile",
        "title": "Use This Constraints File",
        "category": "NexysVHDL"
      },
      {
        "command": "nexysvhdl.check",
        "title": "Check VHDL",
        "category": "NexysVHDL",
        "icon": "$(check)"
      },
      {
        "command": "nexysvhdl.simulate",
        "title": "Simulate",
        "category": "NexysVHDL",
        "icon": "$(play)"
      },
      {
        "command": "nexysvhdl.build",
        "title": "Build",
        "category": "NexysVHDL",
        "icon": "$(tools)"
      },
      {
        "command": "nexysvhdl.program",
        "title": "Program FPGA",
        "category": "NexysVHDL",
        "icon": "$(arrow-up)"
      },
      {
        "command": "nexysvhdl.cancel",
        "title": "Cancel Running Action",
        "category": "NexysVHDL",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nexysvhdl.detectBoards",
        "title": "Detect Boards",
        "category": "NexysVHDL",
        "icon": "$(refresh)"
      },
      {
        "command": "nexysvhdl.selectBoard",
        "title": "Use This Board",
        "category": "NexysVHDL"
      },
      {
        "command": "nexysvhdl.openSchematic",
        "title": "Open Design Schematic",
        "category": "NexysVHDL",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "nexysvhdl.openSchematicFromItem",
        "title": "Open Design Schematic Here",
        "category": "NexysVHDL"
      },
      {
        "command": "nexysvhdl.openRtlSchematic",
        "title": "Open RTL Schematic",
        "category": "NexysVHDL",
        "icon": "$(circuit-board)"
      },
      {
        "command": "nexysvhdl.openWaveform",
        "title": "Open Waveform",
        "category": "NexysVHDL",
        "icon": "$(pulse)"
      },
      {
        "command": "nexysvhdl.goToEntity",
        "title": "Go to Entity Declaration",
        "category": "NexysVHDL"
      },
      {
        "command": "nexysvhdl.showEnvironment",
        "title": "Show Environment",
        "category": "NexysVHDL",
        "icon": "$(pulse)"
      },
      {
        "command": "nexysvhdl.showLog",
        "title": "Show Log",
        "category": "NexysVHDL",
        "icon": "$(output)"
      },
      {
        "command": "nexysvhdl.openLocation",
        "title": "Open Source Location",
        "category": "NexysVHDL"
      },
      {
        "command": "nexysvhdl.installToolchain",
        "title": "Install FPGA Toolchain…",
        "category": "NexysVHDL",
        "icon": "$(desktop-download)"
      },
      {
        "command": "nexysvhdl.verifyToolchain",
        "title": "Verify FPGA Toolchain",
        "category": "NexysVHDL"
      },
      {
        "command": "nexysvhdl.gettingStarted",
        "title": "Getting Started",
        "category": "NexysVHDL",
        "icon": "$(book)"
      },
      {
        "command": "nexysvhdl.openThirdPartyNotices",
        "title": "Third-Party Notices",
        "category": "NexysVHDL"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nexysvhdl.refreshProject",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.refreshHierarchy",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.openProjectSettings",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.setTopEntity",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.setTopEntityFromItem",
          "when": "false"
        },
        {
          "command": "nexysvhdl.setTestbench",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.useConstraintsFile",
          "when": "false"
        },
        {
          "command": "nexysvhdl.check",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.simulate",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.build",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.program",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.cancel",
          "when": "nexysvhdl.busy"
        },
        {
          "command": "nexysvhdl.detectBoards",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.selectBoard",
          "when": "false"
        },
        {
          "command": "nexysvhdl.openSchematic",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.openSchematicFromItem",
          "when": "false"
        },
        {
          "command": "nexysvhdl.goToEntity",
          "when": "false"
        },
        {
          "command": "nexysvhdl.openLocation",
          "when": "false"
        },
        {
          "command": "nexysvhdl.openRtlSchematic",
          "when": "nexysvhdl.hasProject"
        },
        {
          "command": "nexysvhdl.openWaveform",
          "when": "nexysvhdl.hasProject"
        }
      ],
      "view/title": [
        {
          "command": "nexysvhdl.openProjectSettings",
          "when": "view == nexysvhdl.project && nexysvhdl.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "nexysvhdl.refreshProject",
          "when": "view == nexysvhdl.project && nexysvhdl.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "nexysvhdl.refreshProject",
          "when": "view == nexysvhdl.files",
          "group": "navigation"
        },
        {
          "command": "nexysvhdl.openSchematic",
          "when": "view == nexysvhdl.hierarchy",
          "group": "navigation@1"
        },
        {
          "command": "nexysvhdl.openRtlSchematic",
          "when": "view == nexysvhdl.hierarchy",
          "group": "navigation@1"
        },
        {
          "command": "nexysvhdl.refreshHierarchy",
          "when": "view == nexysvhdl.hierarchy",
          "group": "navigation@2"
        },
        {
          "command": "nexysvhdl.cancel",
          "when": "view == nexysvhdl.workflow && nexysvhdl.busy",
          "group": "navigation@0"
        },
        {
          "command": "nexysvhdl.showLog",
          "when": "view == nexysvhdl.workflow",
          "group": "navigation@1"
        },
        {
          "command": "nexysvhdl.detectBoards",
          "when": "view == nexysvhdl.hardware",
          "group": "navigation"
        },
        {
          "command": "nexysvhdl.showLog",
          "when": "view == nexysvhdl.results",
          "group": "navigation"
        },
        {
          "command": "nexysvhdl.openWaveform",
          "when": "view == nexysvhdl.workflow",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "nexysvhdl.setTopEntityFromItem",
          "when": "viewItem =~ /^nexysvhdl\\.(source|entity)$/",
          "group": "nexysvhdl@1"
        },
        {
          "command": "nexysvhdl.useConstraintsFile",
          "when": "viewItem == nexysvhdl.constraints",
          "group": "nexysvhdl@1"
        },
        {
          "command": "nexysvhdl.setTestbench",
          "when": "viewItem == nexysvhdl.simulation",
          "group": "nexysvhdl@1"
        },
        {
          "command": "nexysvhdl.openSchematicFromItem",
          "when": "viewItem =~ /^nexysvhdl\\.(entity|topEntity|simEntity)$/",
          "group": "nexysvhdl@2"
        },
        {
          "command": "nexysvhdl.goToEntity",
          "when": "viewItem =~ /^nexysvhdl\\.(entity|topEntity|simEntity)$/",
          "group": "nexysvhdl@3"
        },
        {
          "command": "nexysvhdl.refreshProject",
          "when": "viewItem =~ /^nexysvhdl\\.(source|simulation|constraints|group)/",
          "group": "nexysvhdl@9"
        },
        {
          "command": "nexysvhdl.check",
          "when": "view == nexysvhdl.workflow && viewItem == nexysvhdl.action.check",
          "group": "inline"
        },
        {
          "command": "nexysvhdl.simulate",
          "when": "view == nexysvhdl.workflow && viewItem == nexysvhdl.action.simulate",
          "group": "inline"
        },
        {
          "command": "nexysvhdl.build",
          "when": "view == nexysvhdl.workflow && viewItem == nexysvhdl.action.build",
          "group": "inline"
        },
        {
          "command": "nexysvhdl.program",
          "when": "view == nexysvhdl.workflow && viewItem == nexysvhdl.action.program",
          "group": "inline"
        },
        {
          "command": "nexysvhdl.selectBoard",
          "when": "viewItem == nexysvhdl.board.selectable",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "NexysVHDL",
      "properties": {
        "nexysvhdl.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run Check (VHDL analysis) automatically when a project VHDL file is saved. Build never runs automatically."
        },
        "nexysvhdl.detectBoardsOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Look for connected boards when a project is opened."
        }
      }
    },
    "languages": [
      {
        "id": "vhdl",
        "aliases": [
          "VHDL",
          "vhdl"
        ],
        "extensions": [
          ".vhd",
          ".vhdl"
        ],
        "configuration": "./resources/vhdl/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vhdl",
        "scopeName": "source.vhdl",
        "path": "./resources/vhdl/vhdl.tmLanguage.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "nexysvhdl.gettingStarted",
        "title": "Get started with NexysVHDL",
        "description": "From VHDL to a programmed Nexys A7-100T: set up, create a project, check, simulate, build and program.",
        "steps": [
          {
            "id": "setup",
            "title": "Verify your setup",
            "description": "Check that the NexysVHDL FPGA toolchain is installed (and, on Windows, the Digilent USB/JTAG support needed only for programming).\n[Show Environment](command:nexysvhdl.showEnvironment)\n[Install FPGA Toolchain…](command:nexysvhdl.installToolchain)",
            "media": {
              "markdown": "resources/walkthrough/setup.md"
            },
            "completionEvents": [
              "onCommand:nexysvhdl.showEnvironment"
            ]
          },
          {
            "id": "project",
            "title": "Create or open a project",
            "description": "A NexysVHDL project is a folder with nexysvhdl.json, src/, sim/ and constraints/.\n[Create NexysVHDL Project](command:nexysvhdl.createProject)\n[Open NexysVHDL Project](command:nexysvhdl.openProject)",
            "media": {
              "markdown": "resources/walkthrough/project.md"
            },
            "completionEvents": [
              "onContext:nexysvhdl.hasProject"
            ]
          },
          {
            "id": "edit",
            "title": "Edit VHDL",
            "description": "Write your design in src/ and your testbench in sim/. The Design Hierarchy updates when you save.\n[Show Project Files](command:nexysvhdl.files.focus)",
            "media": {
              "markdown": "resources/walkthrough/edit.md"
            },
            "completionEvents": [
              "onView:nexysvhdl.files"
            ]
          },
          {
            "id": "xdc",
            "title": "Edit the XDC constraints",
            "description": "Pins and clocks are ordinary Xilinx XDC, exactly as in Vivado. Top-level port names must match the XDC.\n[Open Project Settings](command:nexysvhdl.openProjectSettings)",
            "media": {
              "markdown": "resources/walkthrough/xdc.md"
            }
          },
          {
            "id": "check",
            "title": "Check",
            "description": "Analyze and elaborate your VHDL. Errors appear in Problems.\n[Check VHDL](command:nexysvhdl.check)",
            "media": {
              "markdown": "resources/walkthrough/check.md"
            },
            "completionEvents": [
              "onCommand:nexysvhdl.check"
            ]
          },
          {
            "id": "simulate",
            "title": "Simulate",
            "description": "Run the self-checking testbench.\n[Simulate](command:nexysvhdl.simulate)",
            "media": {
              "markdown": "resources/walkthrough/simulate.md"
            },
            "completionEvents": [
              "onCommand:nexysvhdl.simulate"
            ]
          },
          {
            "id": "waveform",
            "title": "Open the waveform",
            "description": "Inspect signals over time after a simulation.\n[Open Waveform](command:nexysvhdl.openWaveform)",
            "media": {
              "markdown": "resources/walkthrough/waveform.md"
            },
            "completionEvents": [
              "onCommand:nexysvhdl.openWaveform"
            ]
          },
          {
            "id": "rtl",
            "title": "Open the RTL Schematic",
            "description": "See the hardware your VHDL describes: registers, multiplexers, adders, logic.\n[Open RTL Schematic](command:nexysvhdl.openRtlSchematic)",
            "media": {
              "markdown": "resources/walkthrough/rtl.md"
            },
            "completionEvents": [
              "onCommand:nexysvhdl.openRtlSchematic"
            ]
          },
          {
            "id": "build",
            "title": "Build",
            "description": "Synthesis, Implementation and Bitstream for the Nexys A7-100T, with timing and resource results.\n[Build](command:nexysvhdl.build)",
            "media": {
              "markdown": "resources/walkthrough/build.md"
            },
            "completionEvents": [
              "onCommand:nexysvhdl.build"
            ]
          },
          {
            "id": "program",
            "title": "Connect and program",
            "description": "Connect the board by USB, turn it on, then program the FPGA.\n[Detect Boards](command:nexysvhdl.detectBoards)\n[Program FPGA](command:nexysvhdl.program)",
            "media": {
              "markdown": "resources/walkthrough/program.md"
            },
            "completionEvents": [
              "onCommand:nexysvhdl.program"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"dist/tests/**/*.test.js\"",
    "cli": "node dist/cli/main.js",
    "toolchain:assemble": "node scripts/toolchain/assemble.mjs",
    "toolchain:pack": "npm run build && node scripts/toolchain/pack.mjs",
    "toolchain:install": "npm run build && node scripts/toolchain/install.mjs",
    "package:win": "node scripts/package.mjs --target win32-x64",
    "package:mac": "node scripts/package.mjs --target darwin-arm64"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/vscode": "~1.120.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "vhdl",
    "fpga",
    "nexys",
    "digilent",
    "xilinx",
    "artix-7",
    "education",
    "classroom"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "NexysVHDL runs its FPGA tools on the project files, so the folder must be trusted."
    },
    "virtualWorkspaces": false
  }
}
