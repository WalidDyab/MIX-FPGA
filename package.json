    ],
    "themes": [
      {
        "label": "NexysVHDL Classroom",
        "uiTheme": "vs-dark",
        "path": "./resources/themes/nexysvhdl-classroom-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.nvproj": "json"
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"dist/tests/**/*.test.js\"",
    "cli": "node dist/cli/main.js",
    "toolchain:assemble": "node scripts/toolchain/assemble.mjs",
    "toolchain:pack": "npm run build && node scripts/toolchain/pack.mjs",
    "toolchain:install": "npm run build && node scripts/toolchain/install.mjs",
    "compliance:manifest": "node scripts/compliance/manifest.mjs",
    "compliance:assemble": "npm run build && node scripts/compliance/assemble.mjs",
    "compliance:check": "npm run build && node scripts/compliance/manifest.mjs --check && node scripts/compliance/assemble.mjs --draft --offline",
    "package:win": "node scripts/package.mjs --target win32-x64",
    "package:mac": "node scripts/package.mjs --target darwin-arm64"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/vscode": "~1.120.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "vhdl",
    "fpga",
    "nexys",
    "digilent",
    "xilinx",
    "artix-7",
    "education",
    "classroom"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "MIX-FPGA runs its FPGA tools on the project files, so the folder must be trusted."
    },
    "virtualWorkspaces": false
  }
}
