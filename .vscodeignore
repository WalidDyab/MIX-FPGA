# NexysVHDL VSIX content: an allowlist. Everything is excluded unless listed.
# The FPGA toolchain is NOT in the VSIX: it is a separate, versioned artifact
# (nexysvhdl-toolchain-<version>-<target>.tar.gz) installed once per user.
**

# Compiled runtime (no TypeScript sources, declarations, source maps, tests or CLI)
!dist/core/**/*.js
!dist/platform/**/*.js
!dist/runtime/**/*.js
!dist/extension/**/*.js

# Manifest, language support, icons, Getting Started pages
!package.json
!resources/**

# Board data used at runtime (pins, starter XDC, identification)
!boards/**/*.json

# The toolchain version this release requires (content hash per platform)
!toolchains/bundle/requirement.json

# MIX-FPGA board support on macOS: the recorded DE10-Lite toolchain manifest and the pinned support payloads (hashes only, no binaries)
!toolchains/mixfpga/toolchain-1.0-macos-arm64.json
!toolchains/mixfpga/payloads-1.0.json

# MIX-FPGA board support on Windows: the recorded DE10-Lite toolchain manifest and the pinned support payloads (hashes only, no binaries)
!toolchains/mixfpga/toolchain-1.0-windows-x64.json
!toolchains/mixfpga/payloads-1.0-windows-x64.json

# License of NexysVHDL itself (Apache-2.0) and its notice
!LICENSE
!NOTICE

# Student documentation, release notes and notices
!CHANGELOG.md
!THIRD_PARTY_NOTICES.md
!docs/student-install-windows.md
!docs/student-install-macos.md
!docs/student-quick-start.md
